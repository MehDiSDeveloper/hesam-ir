# Copy to .env for local work; on the host set these as real environment vars.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000
# Where SQLite, uploads and collected static live. One mounted volume in production.
DJANGO_DATA_DIR=data
# First-visit language by country: Iran → /, Germany → /de/, elsewhere → /en/.
# Set 0 to switch it off. The country comes from a proxy header if one is named
# (Cloudflare: HTTP_CF_IPCOUNTRY), otherwise from data/geoip/country.mmdb.
DJANGO_GEO_LANGUAGE=1
DJANGO_GEO_COUNTRY_HEADER=
# Behind nginx the client address is in a header, e.g. HTTP_X_REAL_IP.
DJANGO_GEO_CLIENT_IP_HEADER=
# DJANGO_GEO_DATABASE=data/geoip/country.mmdb
# The admin login, (re)applied on every boot by start.sh → ensure_admin: the user is
# created if missing and its password is set back to this value, so the .env always wins.
# REQUIRED: without a password the boot stops (the repo is public, so there is no default).
DJANGO_ADMIN_USERNAME=hesam
DJANGO_ADMIN_PASSWORD=
# Bale bot: every contact message is posted to these chats with status buttons
# (new / read / rejected / archived / starred). Send /id to the bot to learn a
# chat id; several are comma-separated. The webhook is registered on boot and
# needs an https DJANGO_SITE_URL; otherwise run `manage.py bale_poll`.
BALE_BOT_TOKEN=
BALE_CHAT_IDS=
# BALE_WEBHOOK_SECRET=   # optional; derived from DJANGO_SECRET_KEY if unset
